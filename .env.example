# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=NexusAI
APP_ENV=development
APP_PORT=8000
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexusai:nexusai_password@localhost:5432/nexusai_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_TASKS=nexusai_tasks
CHROMA_COLLECTION_FAILURES=nexusai_failures
CHROMA_COLLECTION_PATTERNS=nexusai_patterns

# ── LLM Providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── LLM Behaviour ─────────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=gemini
FALLBACK_ORDER=gemini,claude,gpt4,ollama
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096

# ── JWT Auth ───────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Cost Controls ─────────────────────────────────────────────────────────
ENABLE_COST_ESTIMATION=true
COST_ALERT_THRESHOLD_USD=10.0
COST_HARD_LIMIT_USD=50.0
DEFAULT_MONTHLY_BUDGET_USD=100.0

# ── HITL Controls ─────────────────────────────────────────────────────────
HITL_STORE_BACKEND=redis
HITL_ENABLED=true
HITL_TIMEOUT_SECONDS=300
HITL_HIGH_RISK_TOOLS=execute_code,write_file,delete_file,call_api,run_sql

# ── Security ───────────────────────────────────────────────────────────────
ENABLE_PROMPT_INJECTION_SCAN=true
INJECTION_BLOCK_THRESHOLD=0.85

# ── Docker Sandbox ─────────────────────────────────────────────────────────
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK_DISABLED=true

# ── Observability ──────────────────────────────────────────────────────────
ENABLE_OPENTELEMETRY=true
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
ENABLE_HALLUCINATION_DETECTION=true
HALLUCINATION_SCORE_THRESHOLD=0.70

# ── Multi-Tenancy ──────────────────────────────────────────────────────────
ENABLE_MULTI_TENANCY=true
DEFAULT_TENANT_RATE_LIMIT=100
