# NexusAI frontend — environment template (copy to `.env.local` for local dev).
#
# Never put secrets here: anything prefixed with VITE_ is embedded in the
# browser bundle. The backend's JWT secret, database URL and provider API keys
# belong to the backend only.

# Use the real backend (false) instead of the built-in in-browser mock (true).
VITE_USE_MOCK=false

# Public origin of the NexusAI API, WITHOUT a trailing slash.
# Leave EMPTY to use same-origin relative URLs — in development the Vite dev
# server proxies /api and /ws to the backend (see VITE_PROXY_TARGET below), and
# in production a reverse proxy (Nginx) serves the API on the same origin.
VITE_API_BASE_URL=

# Absolute WebSocket origin, e.g. ws://localhost:8000 or wss://api.example.com.
# Leave EMPTY to derive it from the page origin (works with the dev proxy and
# with a production reverse proxy).
VITE_WS_BASE_URL=

# Backend host used by the development proxy only (not shipped to the browser).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# HITL approval window in seconds; must match the backend's HITL_TIMEOUT_SECONDS.
VITE_HITL_TIMEOUT_SECONDS=300

VITE_APP_NAME=NexusAI
VITE_APP_VERSION=0.1.0
